# Скопируйте в .env.local и заполните своими значениями (для локальной работы)
# На Vercel эти же переменные добавьте в Project Settings → Environment Variables.

# ─── Обязательные ────────────────────────────────────────────────────
# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Пароль администратора для /admin
ADMIN_PASSWORD=change-me

# Секрет для ежедневной синхронизации новостей из VK (vercel.json → crons).
# Без него POST /api/cron/news-sync отдаёт 500 (fail-closed) и автосинхронизация
# НЕ работает. Vercel сам присылает его как `Authorization: Bearer <CRON_SECRET>`.
# Сгенерировать: openssl rand -hex 32
CRON_SECRET=change-me-to-random-32-bytes

# ─── Необязательные ──────────────────────────────────────────────────
# Отдельный секрет для подписи admin-cookie (по умолчанию берётся service role key)
# ADMIN_SECRET=random-long-string

# Уведомления о новых заявках в Telegram. Без этих двух переменных заявки
# сохраняются в БД, но уведомления не отправляются (в логах будет предупреждение).
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=-1001234567890

# VK API для граббера новостей
# VK_SERVICE_KEY=your_vk_service_key
# VK_COMMUNITY_DOMAIN=sfera_gk