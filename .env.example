# Скопируйте в .env.local и заполните своими значениями (для локальной работы)
# На Vercel эти же переменные добавьте в Project Settings → Environment Variables.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Пароль администратора для /admin
ADMIN_PASSWORD=change-me
# Необязательно: отдельный секрет для подписи cookie (по умолчанию берётся service role key)
# ADMIN_SECRET=random-long-string
